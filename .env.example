# Copy this file to .env and replace every required value before starting Docker.
HTTP_PORT=8080

DB_NAME=feria_saberes
DB_USER=feria_saberes
# Use URL-safe characters (letters and numbers) in DB_PASSWORD.
DB_PASSWORD=
DB_ROOT_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Used only the first time the database is initialized.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Optional: required only for project image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
