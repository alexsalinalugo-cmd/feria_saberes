generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model checkin {
  id          Int                @id @default(autoincrement())
  categoria   checkin_categoria? @default(otro)
  integrantes Int                @default(1)
  nombre      String?            @db.VarChar(150)
  created_at  DateTime?          @default(now()) @db.Timestamp(0)
}

model division {
  id          Int                  @id @default(autoincrement())
  anio        String               @db.VarChar(50)
  ciclo       division_ciclo
  division    String?              @db.VarChar(50)
  orientacion division_orientacion
  proyectos   proyectos[]
}

model expositores {
  id              Int       @id @default(autoincrement())
  nombre_completo String    @db.VarChar(150)
  proyecto_id     Int
  proyectos       proyectos @relation(fields: [proyecto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "expositores_ibfk_1")

  @@index([proyecto_id], map: "proyecto_id")
}

model imagenes_proyectos {
  id           Int       @id @default(autoincrement())
  url_imagen   String    @db.VarChar(500)
  proyecto_id  Int
  es_principal Boolean?  @default(false)
  proyectos    proyectos @relation(fields: [proyecto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "imagenes_proyectos_ibfk_1")

  @@index([proyecto_id], map: "proyecto_id")
}

model proyectos {
  id                 Int                  @id @default(autoincrement())
  titulo             String               @db.VarChar(255)
  descripcion        String?              @db.Text
  valoracion         Int?                 @default(0)
  division_id        Int
  usuario_id         Int?
  expositores        expositores[]
  imagenes_proyectos imagenes_proyectos[]
  division           division             @relation(fields: [division_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "proyectos_ibfk_1")
  usuario            usuarios?            @relation(fields: [usuario_id], references: [id], onUpdate: NoAction, map: "proyectos_ibfk_usuario")
  resenas_proyectos  resenas_proyectos[]

  @@index([division_id], map: "division_id")
  @@index([usuario_id])
}

model usuarios {
  id         Int           @id @default(autoincrement())
  nombre     String        @db.VarChar(100)
  dni        String        @unique(map: "dni") @db.VarChar(20)
  contrasena String        @db.VarChar(255)
  rol        usuarios_rol? @default(usuario)
  proyectos  proyectos[]
}

model resenas_proyectos {
  id          Int       @id @default(autoincrement())
  proyecto_id Int
  nombre      String?   @db.VarChar(80)
  comentario  String    @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  proyectos   proyectos @relation(fields: [proyecto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "resenas_proyectos_ibfk_1")

  @@index([proyecto_id], map: "proyecto_id")
}

enum checkin_categoria {
  familiar
  alumno
  docente
  otro
}

enum division_orientacion {
  electricidad
  informatica
}

enum usuarios_rol {
  admin
  usuario
}

enum division_ciclo {
  Basico
  Superior
}
